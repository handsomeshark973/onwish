# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# .env 는 GitHub에 올라가지 않습니다(.gitignore). 키는 채팅·캡처·메신저에 붙이지 마세요.

# Supabase · 프로젝트 > Project Settings > API (Data API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용 관리 키. AI 이용량 차감 같은 서버 작업에만 쓰이며 브라우저로 나가지 않습니다. Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Resend · API Keys
RESEND_API_KEY=

# Sentry · 프로젝트 > Client Keys (DSN)
SENTRY_DSN=

# Anthropic API · console.anthropic.com > API Keys (Pro 구독과 별개, 크레딧 필요)
ANTHROPIC_API_KEY=

# Inngest · Manage > Event Keys / Signing Key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ConvertAPI · 계정 > API Credentials (Token)
CONVERTAPI_TOKEN=

# YouTube Data API v3 · 영상 등록 때 채널 ID·게시일을 자동으로 채우는 용도(선택). 비워 두면 관리자가 직접 입력합니다. 서버에서만 쓰입니다.
YOUTUBE_API_KEY=

# Vercel Cron이 영상 재확인 주소(/api/cron/video-check)를 부를 때 쓰는 비밀값. 아무 긴 무작위 글자로 정해 Vercel 환경 변수에 같은 이름으로 넣으세요. 비어 있으면 그 주소는 항상 거절됩니다.
CRON_SECRET=

# 게스트(로그인 없이 쓰는 방문자) 제한. 비워 두면 기본값을 씁니다.
# 게스트 1명의 하루 AI 추천 횟수(기본 3), 같은 IP의 게스트 추천 요청 하루 상한(기본 30), 같은 IP가 1시간에 만들 수 있는 게스트 수(기본 10)
GUEST_AI_DAILY_LIMIT=
GUEST_AI_PER_IP_PER_DAY=
GUEST_CREATES_PER_IP_PER_HOUR=

# GitHub · Vercel · v0 는 키 없이 로그인만 합니다.

# ONWISH 설정 (비워 두면 기본값 ONWISH / onwish.live)
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DOMAIN=
# AI 추천에 쓸 Claude 모델 이름
CLAUDE_MODEL=

# AI 추천 끄기: off 로 두면 키가 있어도 AI를 쓰지 않고 규칙 기반 추천만 합니다. 켜려면 이 줄을 지우세요.
ONWISH_AI=

# ── 회원 인증 메일 ──
# console  : 메일을 보내지 않고 서버 콘솔(npm run dev 터미널)에 링크를 출력합니다. 개발 기본값
# resend   : Resend로 한국어/영어 메일을 보냅니다. RESEND_API_KEY(위)와 AUTH_EMAIL_FROM이 필요합니다
# supabase : Supabase가 자기 메일 양식으로 보냅니다. 운영 기본값(Resend 키가 없을 때)
# 비워 두면 개발에서는 console, 운영에서는 Resend 키가 있으면 resend, 없으면 supabase로 정해집니다.
AUTH_EMAIL_MODE=
# 보내는 사람 주소. 예: ONWISH <no-reply@onwish.live> (Resend에서 도메인 인증을 마친 주소여야 합니다)
AUTH_EMAIL_FROM=

# ── 시험용 계정 (npm run seed:test-account 가 만들고, 비어 있으면 값을 만들어 .env에 적습니다) ──
ONWISH_TEST_EMAIL=
ONWISH_TEST_PASSWORD=
